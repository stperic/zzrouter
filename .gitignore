# Binaries (root-only : must not match cmd/zzrouter-node, cmd/zzrouter-launcher, etc.)
/zzrouter
/zzrouter-node
/zzrouter-launcher
/zzrouter-node-*
/zzrouter-launcher-*
/zzrouter-linux-*
/zzrouter-darwin-*
/zzrouter-windows-*
test_syntax
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test files in root (keep tests in proper test directories)
/test_*.go
/test-*.py
/test_*.sh
/test-*.sh

# Test app binaries
test-app/test-provider

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Dependency directories
# Go modules are fetched via `go mod download` at build time rather than
# vendored into the repo. If you need reproducible offline builds, run
# `go mod vendor` locally : the resulting vendor/ directory is gitignored.
vendor/

# Go workspace files
go.work
go.work.sum

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Environment files
.env
.env.*
.env.local
.env.*.local
*.env
# The stack contract is process config, not a secret, and both hooks read it.

# Docker override files (may contain secrets)
docker-compose.override.yml
docker-compose.override.yaml

# Configuration files with secrets
config/host-*.yaml
config/providers/
!config/*.example
!config/*.yaml.example

# Log files
*.log
/logs/

# Cache directories
.cache/
__pycache__/

# Build directories
dist/
build/
bin/

# Windows resource objects (generated by go-winres, not committed)
*.syso

# Temporary files
tmp/
temp/
*.tmp

# Debug files
debug
*.pprof

# Local development
local/
.local/

# Test artifacts
testdata/output/
server.test

# Payloads saved out of the logs TUI (carry prompt content)
zzrouter-payload-*.json

# Transient e2e coverage ledgers + fetched route catalog. The rendered
# tracker (docs/api_coverage.md) is committed; these inputs are not.
.e2e-coverage/

# Operator-local site inventories; only the neutral example is public.
/test/e2e/configs/sites/*.yaml
!/test/e2e/configs/sites/example.yaml

# Local inventories, private project notes and assistant configuration.
/docs/evidence/
/docs/plan*
/docs/handoff*
/docs/acceptance*
/docs/audit*
/docs/review*
/docs/superpowers/
/docs/agent-memory.md
/docs/api_examples.md
/CLAUDE.md
/AGENTS.md
/.claude/
/.codex/
/.agents/
/scripts/oss/
/config/host-dev.yaml.example
/docker-compose.override.yml.example
