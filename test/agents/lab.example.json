{
  "nodes": {
    "mac-coordinator": {
      "providers": [
        "mlx"
      ],
      "cloud": true
    },
    "linux-gpu-worker": {
      "providers": [
        "vllm",
        "llamacpp",
        "ollama"
      ],
      "projector_reset": "ssh root@linux-gpu-worker rm -f /var/lib/zzrouter/models/{repo}/{file}"
    },
    "windows-worker": {
      "providers": [
        "llamacpp",
        "ollama"
      ],
      "projector_reset": "ssh windows-worker powershell -NoProfile -Command Remove-Item -Force C:/WINDOWS/system32/config/systemprofile/AppData/Local/zzrouter/models/{repo}/{file}"
    }
  },
  "roles": {
    "text": {
      "family": "Qwen2.5",
      "size": "0.5B",
      "variant": "Instruct",
      "ollama": "qwen2.5"
    },
    "vision": {
      "family": "gemma-4",
      "size": "E2B",
      "variant": "it",
      "ollama": "gemma4",
      "vision": true
    },
    "big": {
      "family": "Qwen3.8",
      "size": "27B",
      "ollama": "qwen3.8",
      "largest": true
    }
  },
  "backend_models": {
    "mac-coordinator": "mlx-community/Qwen3.5-9B-MLX-4bit@mac-coordinator",
    "linux-gpu-worker": "Qwen3.8-27B-Q8_0+claude-code@linux-gpu-worker"
  }
}
