{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zzfactor.io/schemas/registry.schema.json",
  "title": "zzRouter search registry",
  "description": "A search-only catalog (today: huggingface). Never serves inference.",
  "type": "object",
  "required": ["runtime"],
  "additionalProperties": false,
  "allOf": [{"if": {"properties": {"runtime": {"required": ["api"]}}}, "then": {"required": ["connection"]}}],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "enabled": { "type": "boolean" },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": { "type": "string" },
        "sort_options": { "type": "array", "items": { "type": "string" } },
        "client_sorts": { "type": "array", "items": { "type": "string" } },
        "client_filter": { "type": "boolean" },
        "has_tags": { "type": "boolean" }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "test_path": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "type",
              "env"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "text",
                  "endpoint",
                  "identifier"
                ]
              },
              "secret": {
                "type": "boolean"
              },
              "required": {
                "type": "boolean"
              },
              "env": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "env_aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default": {
                "type": "string"
              },
              "fallback_file": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["endpoint"],
      "additionalProperties": false,
      "properties": {
        "api": {
          "type": "object",
          "required": [
            "auth_type"
          ],
          "additionalProperties": false,
          "properties": {
            "auth_type": {
              "enum": [
                "bearer",
                "api-key",
                "custom",
                "none"
              ]
            },
            "auth_header": {
              "type": "string"
            },
            "auth_prefix": {
              "type": "string"
            },
            "token": {
              "type": "string"
            },
            "custom_headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "rate_limit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "requests_per_minute": {
                  "type": "integer",
                  "minimum": 0
                },
                "tokens_per_minute": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "endpoint": { "type": "string", "minLength": 1 },
        "model_url": { "type": "string" },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "const": "api" }
          }
        }
      }
    }
  }
}
