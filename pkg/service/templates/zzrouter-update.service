# zzRouter Updater
# This file is auto-generated by zzrouter-node during service installation.
# Manual changes will be overwritten on service reinstallation.
#
# WHY THIS UNIT EXISTS AND RUNS AS ROOT
#
# zzrouter-node.service runs as the unprivileged zzrouter user, and the
# install tree under /opt/zzrouter is root-owned. That is deliberate: a
# service account that can rewrite its own binary can also rewrite the
# binary an operator later runs under sudo, which turns a compromise of
# the node process into root on the machine. So the node never replaces
# its own binaries on a service install -- it asks, and this runs.
#
# The node asks by writing /var/lib/zzrouter/update/request.json, which
# zzrouter-update.path watches for. Nothing here needs polkit, dbus or a
# sudoers rule: the node's entire capability is creating a file in its
# own state directory.
#
# Triggered two ways:
#   zzrouter-update.path    - the node asked (API, TUI or CLI)
#   zzrouter-update.timer   - the scheduled check
#
# MANAGEMENT:
#   systemctl start zzrouter-update.service     run one now
#   systemctl status zzrouter-update.service
#   journalctl -u zzrouter-update -f

[Unit]
Description=zzRouter Node Updater
Documentation=https://github.com/stperic/zzrouter
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# No User= on purpose. See the header: this is the privileged half of
# the split, and running it as zzrouter would defeat the entire point.
ExecStart=/opt/zzrouter/bin/zzrouter-node update run

# The node's config lives here whoever is running. Without this, root
# resolves its own config directory and reads a different node.yaml than
# the service does -- so the updater would apply a different channel,
# pin and policy than the one the operator configured.
Environment=ZZROUTER_CONFIG_DIR=/etc/zzrouter

# A download over a slow link plus a health-checked restart. The default
# 90s would kill a run mid-install.
TimeoutStartSec=45min

# One run at a time. A timer firing while a requested run is in flight
# would otherwise have two processes installing into the same tree.
# oneshot units already serialise, but say so rather than rely on it.
RemainAfterExit=no

# Hardening is deliberately light. This unit exists to write the install
# tree and restart another unit; most of what would be worth locking
# down is exactly what it needs.
NoNewPrivileges=no
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
