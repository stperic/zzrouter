# zzRouter Update Check Schedule
# This file is auto-generated by zzrouter-node during service installation.
# Manual changes will be overwritten on service reinstallation.
#
# The scheduled half of the updater. A run with no request file waiting
# is a check: it asks the release feed what is out there, records it, and
# applies it only if node.yaml says to.
#
# The timer decides how often the node LOOKS. Whether it then installs
# anything is update.auto_update in node.yaml, and when it is allowed to
# is the maintenance window. Turning updates off is a config change, not
# a matter of disabling this timer -- an operator who masks the timer
# still has a node that installs on request.

[Unit]
Description=Periodic zzRouter update check
Documentation=https://github.com/stperic/zzrouter

[Timer]
# Not at boot: a fleet restarted together would otherwise all reach the
# release feed in the same second.
OnBootSec=15min
OnUnitActiveSec=6h

# Spread the fleet out. Without this, nodes installed from the same
# script drift into lockstep and hammer the feed together.
RandomizedDelaySec=30min

# Catch up on a check missed while the machine was off, rather than
# waiting a full interval. Matters for the laptops in the fleet.
Persistent=true

Unit=zzrouter-update.service

[Install]
WantedBy=timers.target
