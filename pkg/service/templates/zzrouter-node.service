# zzRouter Node Systemd Service File
# This file is auto-generated by zzrouter-node during service installation.
# Manual changes will be overwritten on service reinstallation.
#
# FHS-COMPLIANT PATHS:
#   Config: /etc/zzrouter/
#   Data:   /var/lib/zzrouter/
#   Logs:   journalctl -u zzrouter-node -f
#
# MANAGEMENT:
#   systemctl status zzrouter-node
#   systemctl stop zzrouter-node
#   systemctl restart zzrouter-node
#   journalctl -u zzrouter-node -f

[Unit]
Description=zzRouter Node Service - Distributed LLM Management Platform
Documentation=https://github.com/stperic/zzrouter
After=network.target network-online.target
Wants=network-online.target

[Service]
# Service type and user
Type=simple
User=zzrouter
Group=zzrouter
WorkingDirectory=/var/lib/zzrouter

# Command - uses --no-setup to skip first-run setup (already done)
#
# The managed layout: this is a symlink naming the running version, and
# an update moves the symlink rather than rewriting the file. ExecStart
# must point at the stable name, never at a version directory, which the
# next update's prune can remove. InstallService substitutes the real
# path when a node was installed somewhere else.
ExecStart=/opt/zzrouter/bin/zzrouter-node start --no-setup
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy
# Load-bearing for auto-update: an applied update exits the node with a
# failure status precisely so this brings it back on the new binary
# (pkg/update/restart.go). Restart=no leaves an updated node stopped;
# the updater checks this directive and refuses to exit when it would.
Restart=on-failure
RestartSec=5s

# Environment
# SECURITY: API keys are loaded from environment file
EnvironmentFile=-/etc/zzrouter/zzrouter.env

# =============================================================================
# SECURITY HARDENING
# =============================================================================
# NOTE: GPU/ML workloads (CUDA, PyTorch, vLLM) require JIT compilation,
# writable+executable memory, and access to /proc/sys and /dev/nvidia*.
# Several common hardening directives are intentionally omitted:
#   - MemoryDenyWriteExecute: Blocks CUDA JIT and PyTorch torch.compile
#   - ProtectKernelTunables: Blocks CUDA access to /proc/sys and /sys
#   - SystemCallFilter=~@resources: Blocks CUDA setrlimit/sched_setaffinity
# These cause "Address family not supported" errors in gloo/torch.distributed
# because seccomp kills memory-mapping syscalls during initialization.

# Prevent privilege escalation
NoNewPrivileges=yes

# Private /tmp directory (isolated from other processes)
PrivateTmp=yes

# Protect system directories
ProtectSystem=strict
ProtectHome=yes
# ProtectKernelTunables=yes -- DISABLED: CUDA reads /proc/sys and /sys device paths
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Read-write paths for the service (FHS compliant)
# /etc/zzrouter is writable so the service can update config on cluster join/leave
ReadWritePaths=/var/lib/zzrouter /var/log/zzrouter /etc/zzrouter /opt/zzrouter/providers

# Restrict address families
# AF_NETLINK is needed by gloo for interface enumeration (getifaddrs)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# Restrict namespaces -- disabled: child processes (vLLM, llama.cpp) may need namespaces
# RestrictNamespaces=yes

# Restrict real-time scheduling
RestrictRealtime=yes

# Restrict SUID/SGID
RestrictSUIDSGID=yes

# Remove capabilities (we don't need any)
CapabilityBoundingSet=
AmbientCapabilities=

# System call filter (allow only necessary syscalls)
# NOTE: @resources is NOT excluded -- CUDA needs setrlimit, prlimit64,
# sched_setaffinity for GPU memory management and CPU pinning
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallArchitectures=native

# Lock memory settings
LockPersonality=yes
# MemoryDenyWriteExecute=yes -- DISABLED: CUDA/PyTorch require mmap(PROT_WRITE|PROT_EXEC)

# =============================================================================
# RESOURCE LIMITS
# =============================================================================

# Memory limit -- disabled by default for GPU workloads
# VRAM is managed by the GPU driver, not cgroups. Setting MemoryMax too low
# will OOM-kill the process while GPU memory is still available.
# Uncomment and adjust if you need to constrain host RAM usage:
# MemoryMax=64G
# MemoryHigh=48G

# CPU quota -- disabled by default
# vLLM and PyTorch use all available cores for model loading and tokenization.
# Uncomment and adjust if you need to share the machine:
# CPUQuota=400%

# File descriptor limit
LimitNOFILE=65536

# Process limit
LimitNPROC=4096

# =============================================================================
# LOGGING
# =============================================================================

# Send logs to journal (preferred over file-based logging)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zzrouter-node

[Install]
WantedBy=multi-user.target
