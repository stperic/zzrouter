# zzRouter Updater Trigger
# This file is auto-generated by zzrouter-node during service installation.
# Manual changes will be overwritten on service reinstallation.
#
# The bridge across the privilege boundary. zzrouter-node runs as the
# unprivileged zzrouter user and cannot write the root-owned install
# tree, so when the API, TUI or CLI asks for an update the node writes a
# request file into its own state directory and systemd starts the
# privileged updater.
#
# The request carries an action and a version and nothing else -- no
# path, no URL, no release source. It is untrusted input to a root
# process; where a binary comes from is decided on the privileged side.
# See pkg/update/handoff.go.
#
# PathExists fires when the file appears and stays quiet while it is
# still there, so the updater must delete the request when it claims it
# or no later request is ever noticed.

[Unit]
Description=Watch for a zzRouter update request
Documentation=https://github.com/stperic/zzrouter

[Path]
PathExists=/var/lib/zzrouter/update/request.json
Unit=zzrouter-update.service

[Install]
WantedBy=multi-user.target
