# Every checkout is LF, Windows included. Embedded templates, schemas,
# scripts and units are compiled into the binary and hashed, and the
# Windows release is built on a Windows runner, so autocrlf would ship
# different bytes on one platform. PowerShell reads LF scripts fine.
* text=auto eol=lf

# SSE fixtures retain the blank line that terminates their final frame.
pkg/protocol/anthropic/testdata/*.sse whitespace=-blank-at-eof
