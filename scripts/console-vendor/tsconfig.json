{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "*": ["./node_modules/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "eventsource-parser/stream": ["./node_modules/eventsource-parser/dist/stream.d.ts"]
    }
  },
  "include": ["../../internal/server/web/chat/**/*.ts", "../../internal/server/web/chat/**/*.tsx"]
}
