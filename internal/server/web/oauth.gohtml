<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{.Title}} | zzRouter</title><style>
:root{color-scheme:dark}body{margin:0;background:#101725;color:#edf2fa;font:16px system-ui,sans-serif;display:grid;min-height:100vh;place-items:center}main{box-sizing:border-box;width:min(520px,94vw);margin:2rem;padding:2rem;background:#1c2941;border:1px solid #34435b;border-radius:16px}h1{font-size:1.6rem}p{line-height:1.6;color:#c1ccdf}small{overflow-wrap:anywhere;color:#a6b6cf}label{display:block;margin:1rem 0}input{box-sizing:border-box;width:100%;padding:.8rem;margin-top:.5rem;background:#101725;border:1px solid #65748b;border-radius:7px;color:white;font:inherit}button{font:inherit;padding:.75rem 1rem;border:0;border-radius:7px;background:#79b6ff;color:#10223b;cursor:pointer;margin:.5rem .4rem .5rem 0}.secondary{background:#33435b;color:white}a{color:#9dcaff}.error{color:#ffbaad}.connection{border-top:1px solid #34435b;padding:1rem 0}</style><main><small>zzRouter</small><h1>{{.Title}}</h1>{{if .Message}}<p class="error">{{.Message}}</p>{{end}}
{{if .Pending}}<p>Client name (unverified): <strong>{{.Client}}</strong></p><p>Requests <strong>{{.Scope}}</strong> access to <small>{{.Resource}}</small>.</p><p>Callback address<br><small>{{.Callback}}</small></p><p><small>Verify this address belongs to the application you want to connect.</small></p><form method="post" action="/oauth/authorize"><input type="hidden" name="pending" value="{{.Pending}}"><input type="hidden" name="csrf" value="{{.CSRF}}">{{if .SignedIn}}<p>Signed in as {{.Identity}}. This client will receive its own revocable connection.</p>{{else}}<label>Your zzRouter API key<input type="password" name="key" autocomplete="off" required autofocus></label><p>Your key stays with zzRouter. The client receives a separate authorization.</p>{{end}}<button name="action" value="allow">{{if .SignedIn}}Allow connection{{else}}Sign in and connect{{end}}</button><button class="secondary" name="action" value="deny" formnovalidate>Cancel</button></form>
{{else}}{{if .SignedIn}}<p>Signed in as {{.Identity}}.</p>{{range .Connections}}<div class="connection"><strong>{{.Client}}</strong><p>{{.Scope}} · Connected {{.CreatedAt.Format "2006-01-02"}}</p><form method="post" action="/oauth/connections"><input type="hidden" name="csrf" value="{{$.CSRF}}"><input type="hidden" name="grant" value="{{.ID}}"><button class="secondary">Revoke access</button></form></div>{{else}}<p>No active connections.</p>{{end}}<form method="post" action="/oauth/logout"><input type="hidden" name="csrf" value="{{.CSRF}}"><button class="secondary">Sign out</button></form>{{else}}<form method="post" action="/oauth/connections"><input type="hidden" name="csrf" value="{{.CSRF}}"><label>Your zzRouter API key<input type="password" name="key" autocomplete="off" required autofocus></label><button>Sign in</button></form>{{end}}{{end}}<p><a href="/oauth/connections">Manage connected clients</a></p></main></html>